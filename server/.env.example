# Receipt verifier server environment
# Copy to .env and fill in your production values.

# Apple App Store Server API
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
BUNDLE_ID=com.anonymous.babybubblebabble
APPSTORE_ENVIRONMENT=production

# Google Play Developer API
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_PACKAGE_NAME=com.anonymous.babybubblebabble

# Runtime
PORT=8080
